# NEONTRACE Environment Configuration Template
# Copy to .env.local for local overrides

NEXT_PUBLIC_APP_URL=https://neontrace.app
NEXT_PUBLIC_MAP_PROVIDER=carto
NEXT_PUBLIC_DEFAULT_LAT=40.7128
NEXT_PUBLIC_DEFAULT_LNG=-74.0060

# Google Maps API Configuration
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google OAuth Configuration (Optional, demo mode works without credentials)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
